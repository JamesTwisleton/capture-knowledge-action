# Copy to .env before starting the stack:  cp .env.example .env
#
# .env is gitignored and this template is not, because from T20 ./setup.sh writes real
# credentials in here — Google OAuth client ID and secret, GitHub token, LLM provider
# key, optional Jev key. Add placeholders to the template, never values.
#
# Compose reads this file twice: to substitute ${...} in docker-compose.yml, and again
# via env_file so the same values reach the processes inside the containers.
#
# One variable per line and never twice: a later assignment wins, for Compose and for
# `set -a; . .env`, so a second blank GOOGLE_CLIENT_ID= further down silently empties a real
# one set above it. Add a new value to the block it belongs to rather than to the end.

# Backend
BACKEND_PORT=8080
JVM_DEBUG_PORT=5005

# Frontend. The browser resolves NEXT_PUBLIC_API_URL, so it must be a host address —
# Docker service names mean nothing outside the container network.
FRONTEND_PORT=3000
NODE_DEBUG_PORT=9229
NEXT_PUBLIC_API_URL=http://localhost:8080

# Event bus (RabbitMQ). Local defaults; the management UI is on the second port.
EVENT_BUS_PORT=5672
EVENT_BUS_MGMT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ---- Providers, in the order the pipeline reaches them ------------------------------------
# Each one that needs a credential ships switched off, because selecting it without one stops
# the backend starting and a fresh clone has to come up before anybody has any. T20's
# ./setup.sh asks for each credential and flips the matching selection in one go.

# 1. Capture — Google Drive (T09). Four values, then flip CKA_PROVIDER_CAPTURE to google-drive.
#
# GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET: a **Desktop app** OAuth client from Google Cloud
# Console (APIs & Services → Credentials), on a project with the Drive API enabled. Desktop
# rather than Web, because consent redirects to a loopback port that needs no registering.
# The consent screen must be **published**: one left in Testing expires refresh tokens after
# seven days, and the pipeline then stops capturing with no obvious cause.
#
# GOOGLE_DRIVE_FOLDER_ID: the last part of the folder's URL in Drive —
# drive.google.com/drive/folders/THIS_PART. Meet's own folder is usually "Meet Recordings".
#
# GOOGLE_REFRESH_TOKEN: printed by ./app/scripts/google-consent.sh, which you run once. The
# access tokens it mints last an hour and are renewed from it silently, which is why consent
# is a one-time thing rather than a daily one.
CKA_PROVIDER_CAPTURE=none
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_REFRESH_TOKEN=
CAPTURE_POLL_INTERVAL_SECONDS=60
# Deleting a note from the vault asks for that meeting again. Set false for a vault pruned on a
# schedule, where every pruned note would otherwise be captured and summarised a second time.
CAPTURE_RECAPTURE_DELETED_NOTES=true

# 2. Summarise — LLM provider (T12). Two values: the key, and the selection that turns the
# provider on.
#
# The vendor is not named here. LLM_MODEL plus whichever LangChain4j binding is on the
# classpath decides it, so pointing CKA at Gemini or a local Ollama model is a dependency and
# a bean, not a change to the provider — see backend/src/main/java/com/cka/provider/llm/AGENTS.md.
CKA_PROVIDER_LLM=none
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5

# 3. Store — knowledge vault (T06). The one provider that ships on, because it needs a
# directory rather than a credential. A path *inside* the container, where docker-compose
# mounts ./data/vault, so the notes land on the host and open in Obsidian — or any text
# editor — while the stack runs. Obsidian is not required and is not a dependency.
VAULT_PATH=/data/vault

# Database (SQLite, T10). A path to a file, not a host and port. This is the path *inside* the
# container, where docker-compose.yml mounts ./data/db, so the file lives on the host and can be
# opened in any SQL client while the stack runs. Another SQL database is a different JDBC URL —
# see backend/src/main/java/com/cka/persistence/AGENTS.md.
DB_PATH=/data/db/cka.db
