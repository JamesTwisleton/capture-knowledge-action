# Copy to .env before starting the stack:  cp .env.example .env
#
# .env is gitignored and this template is not, because from T20 ./setup.sh writes real
# credentials in here — Google OAuth client ID and secret, GitHub token, LLM provider
# key, optional Jev key. Add placeholders to the template, never values.
#
# Compose reads this file twice: to substitute ${...} in docker-compose.yml, and again
# via env_file so the same values reach the processes inside the containers.

# Backend
BACKEND_PORT=8080
JVM_DEBUG_PORT=5005

# Frontend. The browser resolves NEXT_PUBLIC_API_URL, so it must be a host address —
# Docker service names mean nothing outside the container network.
FRONTEND_PORT=3000
NODE_DEBUG_PORT=9229
NEXT_PUBLIC_API_URL=http://localhost:8080

# Event bus (RabbitMQ). Local defaults; the management UI is on the second port.
EVENT_BUS_PORT=5672
EVENT_BUS_MGMT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# Knowledge vault (T06). A path *inside* the container, where docker-compose mounts
# ./data/vault, so the notes land on the host and can be opened in Obsidian — or any text
# editor — while the stack runs. Obsidian is not required and is not a dependency.
VAULT_PATH=/data/vault

# LLM provider (T12). Summarising is off until both of these are set: the key, and the selection
# that turns the provider on. Two variables rather than one because a blank key with the provider
# selected stops the backend starting, and a fresh clone has to come up before you have a key —
# T20's ./setup.sh asks for the key and flips the selection in one go.
#
# The vendor is not named here. LLM_MODEL plus whichever LangChain4j binding is on the classpath
# decides it, so pointing CKA at Gemini or a local Ollama model is a dependency and a bean, not a
# change to the provider — see backend/src/main/java/com/cka/provider/llm/AGENTS.md.
CKA_PROVIDER_LLM=none
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5

# Database (SQLite, T10). A path to a file, not a host and port. This is the path *inside* the
# container, where docker-compose.yml mounts ./data/db, so the file lives on the host and can be
# opened in any SQL client while the stack runs. Another SQL database is a different JDBC URL —
# see backend/src/main/java/com/cka/persistence/AGENTS.md.
DB_PATH=/data/db/cka.db
