<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.cka</groupId>
    <artifactId>cka-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>cka-backend</name>
    <description>Capture-Knowledge-Action Core Backend Service</description>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <properties>
        <java.version>25</java.version>
        <!-- Spring Boot 4.1.1 manages Tomcat 11.0.24, which still carries CVEs fixed in
             11.0.25. Overriding the managed version is the supported way to get ahead of a
             Boot release. Remove it once Boot catches up — see issue #26. -->
        <tomcat.version>11.0.26</tomcat.version>
        <!-- Spring Boot 4.1.1 manages Lombok 1.18.46, whose annotation processor silently does
             nothing under JDK 25 — no error, generated members just don't appear. 1.18.48 fixes
             it. Same override mechanism as tomcat.version above; remove once Boot catches up —
             see issue #27. -->
        <lombok.version>1.18.48</lombok.version>
        <!-- Not managed by Spring Boot's BOM, so the version lives here. -->
        <langchain4j.version>1.8.0</langchain4j.version>
        <google-drive.version>v3-rev20250216-2.0.0</google-drive.version>
        <google-auth.version>1.30.1</google-auth.version>
        <guava.version>33.4.8-jre</guava.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Actuator gives us /actuator/health for free. T02 requires it; T04 builds
             the connectivity slice on it. No hand-written health endpoint needed. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Spring AMQP: the RabbitMQ client, connection management and listener containers
             behind the EventBus provider (T07). Publishing and subscribing are the whole of
             PRD 8.1's interface, so nothing here is wrapped or re-abstracted. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!-- Spring Data JDBC for the SQL persistence layer (T10), the shared foundation prompt
             storage (T11) and the audit chain (T14) both build on. JDBC rather than JPA: the
             mapping here is rows to records with no lazy loading, dirty checking or session to
             reason about, and Spring Data JDBC writes exactly the SQL you would have written. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jdbc</artifactId>
        </dependency>

        <!-- Versioned schema migrations, applied at startup and checked in beside the schema they
             create. The starter, not flyway-core on its own: Boot 4 splits auto-configuration into
             a module per technology, so flyway-core alone puts Flyway on the classpath without
             anything that runs it, and migrations are silently never applied. SQLite support is
             inside flyway-core, so no database module is needed on top — the only SQLite artifact
             Flyway publishes is for its native-connectors path, which this does not use. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>

        <!-- Reads a note's front matter back (T09's recapture on delete). Already on the classpath
             through Boot; declared because the vault now calls it directly. Version from Boot. -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>

        <!-- SQLite: the default database, and the only one the MVP tests (T10). A single file,
             so there is no server to run and no credentials to configure. Runtime scope — nothing
             compiles against the driver, Boot resolves it from the jdbc:sqlite: URL. -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Google Drive, for T09's folder watcher. Official Google clients rather than a
             self-written HTTP wrapper, which is the distinction decision 60 drew: CKA depends on
             a vendor's own client *because* it is authoritative about its own API, and declined
             community Jev clients because they were not. Two artifacts, not the BOM: the Drive
             API itself, and the auth library for a refresh token and the silent renewal of access
             tokens. Deliberately not google-oauth-client-jetty — UserAuthorizer exchanges the
             consent code on its own, so the one-time consent flow needs the JDK's HTTP server
             and not a second web server on the application's classpath. -->
        <!-- Pinned ahead of what the Google clients ask for, and to the -jre flavour rather than
             -android. 33.3.1-android reaches into sun.misc.Unsafe from AbstractFuture, which
             JDK 24+ warns about on every start (JEP 498) and which a later JDK will remove
             outright. 33.4.8-jre has no UnsafeAtomicHelper in it at all — it uses VarHandle —
             so this fixes the warning at its cause rather than silencing it with a JVM flag.
             Verified by loading AbstractFuture under both and watching for the warning.
             Remove the pin once the Google clients depend on a Guava this new. -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>${guava.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.apis</groupId>
            <artifactId>google-api-services-drive</artifactId>
            <version>${google-drive.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.auth</groupId>
            <artifactId>google-auth-library-oauth2-http</artifactId>
            <version>${google-auth.version}</version>
        </dependency>

        <!-- LangChain4j is the one gateway every LLM call goes through (PRD Section 3), which is
             what makes "Claude, Gemini, OpenAI or a local Ollama model, by configuration" a
             config change rather than a code change — and what keeps every call visible to the
             cost tracking J7 needs. langchain4j-anthropic is one vendor binding on top of the
             vendor-neutral `ChatModel` interface in core; adding Gemini or Ollama is another
             dependency and a bean, never a change to the provider. -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-anthropic</artifactId>
            <version>${langchain4j.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- Compile-time only: generates getters/setters/constructors/logging fields from
             annotations, never ships in the jar. optional=true tells spring-boot-maven-plugin
             to leave it out of the repackaged fat jar. No explicit <version> here — same as
             every other dependency in this file — but unlike the others, the version that
             resolves to is NOT what Boot's BOM manages by default. It's the lombok.version
             override above (see issue #27), because the BOM's own 1.18.46 doesn't work under
             JDK 25. -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Time-ordered UUIDs (RFC 9562). The JDK only ships random v4, which makes an action
             decision chain's id carry no information and scatter writes across a B-tree index.
             JUG is the reference Java implementation: one small jar, no transitive dependencies,
             Apache 2.0. Needs an explicit version — Spring Boot's BOM does not manage it. -->
        <dependency>
            <groupId>com.fasterxml.uuid</groupId>
            <artifactId>java-uuid-generator</artifactId>
            <version>5.2.0</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- A real broker for the event bus tests, started and thrown away per run. T07's
             acceptance criterion is explicitly "via the real broker", and an in-memory fake
             would prove nothing about serialisation, routing or asynchrony — the three things
             that can actually differ between the test double and RabbitMQ. Needs a working
             Docker daemon, which this project already requires of everyone. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-rabbitmq</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- javac 25 dropped its fallback that discovered annotation processors from
                 -classpath; without an explicit processor path, Lombok's annotations are
                 silently ignored — no error, generated members just don't appear. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- Mockito attaches its byte-buddy agent to the running JVM by itself, which JDK 25
                 warns about on every test run and a future JDK will refuse outright. Passing the
                 agent on the command line instead is Mockito's own documented fix. The
                 dependency plugin's properties goal sets ${org.mockito:mockito-core:jar} to that
                 jar's path in the local repository, so the version stays Boot's to manage. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Native access is granted because the SQLite driver loads a native
                         library, and JDK 24+ warns on every start that restricted methods "will
                         be blocked in a future release unless native access is enabled".
                         Granting it is what the warning asks for and says the call is intended;
                         the alternative is four lines of noise before every test run and,
                         eventually, a driver that cannot load. ALL-UNNAMED because nothing
                         here is modular. (The flag cannot be named in an XML comment: a
                         double hyphen is not allowed inside one.) -->
                    <argLine>-javaagent:${org.mockito:mockito-core:jar} --enable-native-access=ALL-UNNAMED</argLine>
                    <!-- Report each test by its @DisplayName instead of its method identifier, so
                         a CI failure reads as the sentence describing what broke rather than as
                         aMentionMatchingNoCandidateIsAuditedAndNeverProposed. Surefire needs
                         telling twice: once for the console, once for the XML the Actions UI
                         renders. Report *filenames* stay the class name on purpose — display
                         names here contain slashes and apostrophes. -->
                    <statelessTestsetInfoReporter
                            implementation="org.apache.maven.plugin.surefire.extensions.junit5.JUnit5StatelessTestsetInfoReporter">
                        <usePhrasedClassNameInRunning>true</usePhrasedClassNameInRunning>
                        <usePhrasedClassNameInTestCaseSummary>true</usePhrasedClassNameInTestCaseSummary>
                    </statelessTestsetInfoReporter>
                    <statelessTestsetReporter
                            implementation="org.apache.maven.plugin.surefire.extensions.junit5.JUnit5Xml30StatelessReporter">
                        <usePhrasedFileName>false</usePhrasedFileName>
                        <usePhrasedTestSuiteClassName>true</usePhrasedTestSuiteClassName>
                        <usePhrasedTestCaseClassName>true</usePhrasedTestCaseClassName>
                        <usePhrasedTestCaseMethodName>true</usePhrasedTestCaseMethodName>
                    </statelessTestsetReporter>
                </configuration>
            </plugin>

            <!-- One canonical layout, applied by the pre-commit hook in .githooks/ and checked in
                 CI, so formatting never costs anyone a review comment. Palantir's formatter is the
                 closest of the opinionated ones to what this codebase was already written in —
                 four-space indents, 120 columns. Google's would have reflowed every file to
                 two-space indents to no benefit. Deliberately not bound to a lifecycle phase: a
                 formatter that fails `mvn test` interrupts work mid-change, and the hook plus CI
                 already catch it at the two moments that matter. -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>2.44.5</version>
                <configuration>
                    <java>
                        <removeUnusedImports/>
                        <palantirJavaFormat>
                            <version>2.102.0</version>
                        </palantirJavaFormat>
                    </java>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
