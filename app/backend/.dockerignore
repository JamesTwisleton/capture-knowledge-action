# Everything in this directory is uploaded to the Docker daemon as build context
# before the first instruction runs, whether the Dockerfile copies it or not.
# target/ is the one that matters: it does not exist on a clean checkout, but once
# you have built locally it is easily the largest thing here, and it is re-sent on
# every build. The rest is hygiene — secrets must never reach the context, because
# anything in the context can end up in a layer.

# Build output
target/
*.jar
*.war
*.class

# Secrets and local config — never bake these into an image
.env
.env.*
*.pem
*.key

# IDE and OS
.idea/
.vscode/
*.iml
*.swp
.DS_Store

# Logs
*.log

# Not needed inside the image
AGENTS.md
Dockerfile
.dockerignore
.gitignore
