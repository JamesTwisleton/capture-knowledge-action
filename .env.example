# Docker Compose Environment Configuration Template
# Copy this file to .env and adjust variables as needed.

# Backend
BACKEND_PORT=8080
JVM_DEBUG_PORT=5005

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# Event Bus (RabbitMQ)
EVENT_BUS_PORT=5672
EVENT_BUS_MGMT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
